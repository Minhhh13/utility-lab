{
  "name": "utility-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve-local.mjs",
    "dev": "vite --host 127.0.0.1",
    "catalogue:build": "node --experimental-strip-types scripts/build-expanded-catalogue.mjs && node --experimental-strip-types scripts/build-origin-catalogue.mjs",
    "build": "npm run catalogue:build && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:local": "node scripts/check-local.mjs",
    "test:browser": "npm run build && playwright test",
    "test:webkit": "npm run build && playwright test --config playwright.webkit.config.ts",
    "package:local": "npm run build && node --experimental-strip-types scripts/package-local.mjs",
    "prepare:cloudflare": "node scripts/prepare-cloudflare.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
